    {
        "id": "creation-flowchart-login-retry",
        "suite": "creation",
        "input": "Make a flowchart of a login attempt: start, the user enters credentials, then check whether the credentials are valid. If yes, show the dashboard and end. If no, increment the failed-attempts counter and check whether attempts are below 3: if yes, loop back to entering credentials; otherwise lock the account and end.",
        "difficulty": "hard",
        "tags": ["flowchart", "decision", "loop", "edge-label"],
        "expected": {
            "routing": {
                "requiredTools": ["createDiagram"],
                "forbiddenTools": [
                    "updateDiagram",
                    "deleteDiagram",
                    "clearCanvas",
                    "webSearchTool",
                    "knowledgeSearchTool"
                ]
            },
            "diagram": {
                "diagramType": "flowchart",
                "direction": "TB",
                "nodes": [
                    { "label": "Start", "kind": "start" },
                    { "label": ["Enter", "Credentials"] },
                    { "label": "Valid", "kind": "decision" },
                    { "label": "Dashboard" },
                    { "label": ["Increment", "Failed"] },
                    {
                        "label": ["Attempts", "< 3", "below 3"],
                        "kind": "decision"
                    },
                    { "label": "Lock" },
                    { "label": "End", "kind": "end" }
                ],
                "connections": [
                    { "from": "Start", "to": ["Enter", "Credentials"] },
                    {
                        "from": "Valid",
                        "to": "Dashboard",
                        "label": ["yes", "true"]
                    },
                    {
                        "from": "Valid",
                        "to": ["Increment", "Failed"],
                        "label": ["no", "false", "invalid"]
                    },
                    {
                        "from": ["Attempts", "< 3", "below 3"],
                        "to": "Enter",
                        "label": ["yes", "true", "retry"]
                    },
                    {
                        "from": ["Attempts", "< 3", "below 3"],
                        "to": "Lock",
                        "label": ["no", "false"]
                    }
                ],
                "maxNodes": 10
            }
        }
    },
