    {
        "id": "creation-three-tier-web-app",
        "suite": "creation",
        "input": "Draw a simple 3-tier architecture: a React web client calls a Node.js API over HTTPS, and the API stores data in PostgreSQL.",
        "difficulty": "easy",
        "tags": ["architecture", "edge-label"],
        "expected": {
            "routing": {
                "requiredTools": ["createDiagram"],
                "forbiddenTools": [
                    "updateDiagram",
                    "deleteDiagram",
                    "clearCanvas",
                    "webSearchTool",
                    "knowledgeSearchTool"
                ]
            },
            "diagram": {
                "diagramType": "architecture",
                "nodes": [
                    { "label": ["React", "Web Client", "Frontend"] },
                    { "label": ["API", "Node"], "kind": "service" },
                    { "label": ["Postgres"], "kind": "database" }
                ],
                "connections": [
                    {
                        "from": ["React", "Web Client", "Frontend"],
                        "to": ["API", "Node"],
                        "label": "HTTPS"
                    },
                    { "from": ["API", "Node"], "to": ["Postgres"] }
                ],
                "maxNodes": 5
            }
        }
    },
    {
        "id": "creation-aws-vpc-nested-groups",
        "suite": "creation",
        "input": "Draw an AWS architecture: users reach an Application Load Balancer in a public subnet, which routes to two EC2 app servers in a private subnet. The app servers use an RDS database, also in the private subnet. Both subnets are inside a VPC.",
        "difficulty": "hard",
        "tags": ["architecture", "groups", "nesting"],
        "expected": {
            "routing": {
                "requiredTools": ["createDiagram"],
                "forbiddenTools": [
                    "updateDiagram",
                    "deleteDiagram",
                    "clearCanvas",
                    "knowledgeSearchTool"
                ]
            },
            "diagram": {
                "diagramType": "architecture",
                "nodes": [
                    { "label": ["User"] },
                    { "label": ["Load Balancer", "ALB"] },
                    { "label": ["App Server", "EC2"] },
                    { "label": ["RDS"], "kind": "database" }
                ],
                "connections": [
                    { "from": ["User"], "to": ["Load Balancer", "ALB"] },
                    {
                        "from": ["Load Balancer", "ALB"],
                        "to": ["App Server", "EC2"]
                    },
                    { "from": ["App Server", "EC2"], "to": ["RDS"] }
                ],
                "groups": [
                    {
                        "label": "VPC",
                        "contains": [
                            ["Load Balancer", "ALB"],
                            ["App Server", "EC2"],
                            ["RDS"]
                        ]
                    },
                    {
                        "label": "Public",
                        "parent": "VPC",
                        "contains": [["Load Balancer", "ALB"]]
                    },
                    {
                        "label": "Private",
                        "parent": "VPC",
                        "contains": [["App Server", "EC2"], ["RDS"]]
                    }
                ],
                "maxNodes": 7
            }
        }
    },
