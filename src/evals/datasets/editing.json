    {
        "id": "editing-tidy-up-relayout",
        "suite": "editing",
        "input": "The layout of that flowchart got messy after I moved things around. Can you tidy it up?",
        "difficulty": "medium",
        "tags": ["update", "relayout"],
        "seed": {
