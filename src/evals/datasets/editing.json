[
    {
        "id": "editing-rename-shape",
        "suite": "editing",
        "input": "Rename Worker to Queue Consumer",
        "difficulty": "easy",
        "tags": ["modify", "label"],
        "seed": {
            "priorPrompt": "Draw a Worker box",
            "priorResponse": "Created the Worker box.",
            "elements": [
                {
                    "id": "worker",
                    "type": "rectangle",
                    "x": 0,
                    "y": 0,
                    "width": 200,
                    "height": 80,
                    "label": { "text": "Worker" }
                }
            ]
        },
        "expected": {
            "routing": {
                "requiredTools": ["modifyElements"],
                "forbiddenTools": [
                    "drawElements",
                    "deleteElements",
                    "getCanvasState"
                ]
            },
            "editing": {
                "mutations": [
                    {
                        "id": "worker",
                        "type": "rectangle",
                        "changes": { "label": { "text": "Queue Consumer" } }
                    }
                ]
            }
        }
    },
