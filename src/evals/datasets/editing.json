                "diagramId": "signup-flow",
                "nodes": [
                    { "id": "start", "label": "Start", "kind": "start" },
                    { "id": "submit", "label": "Submit Form", "kind": "io" },
                    { "id": "valid", "label": "Valid?", "kind": "decision" },
                    { "id": "create", "label": "Create Account" },
                    { "id": "error", "label": "Show Errors" },
                    { "id": "end", "label": "End", "kind": "end" }
                ],
                "edges": [
                    { "from": "start", "to": "submit" },
                    { "from": "submit", "to": "valid" },
                    { "from": "valid", "to": "create", "label": "yes" },
                    { "from": "valid", "to": "error", "label": "no" },
                    { "from": "error", "to": "submit", "label": "retry" },
                    { "from": "create", "to": "end" }
                ]
            }
        },
