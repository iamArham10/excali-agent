[
    {
        "id": "editing-rename-node-keep-id",
        "suite": "editing",
        "input": "Rename Worker to Queue Consumer",
        "difficulty": "easy",
        "tags": ["update", "rename", "id-stability"],
        "seed": {
            "priorPrompt": "Draw an API that pushes jobs onto a job queue processed by a worker",
            "priorResponse": "I've created the job processing architecture diagram.",
            "diagram": {
                "type": "architecture",
                "diagramId": "job-pipeline",
                "nodes": [
                    { "id": "api", "label": "API" },
                    {
                        "id": "job-queue",
                        "label": "Job Queue",
                        "kind": "queue"
                    },
                    { "id": "worker", "label": "Worker" }
                ],
                "edges": [
                    { "from": "api", "to": "job-queue", "label": "enqueue" },
                    {
                        "from": "job-queue",
                        "to": "worker",
                        "label": "consume",
                        "style": "dashed"
                    }
                ]
            }
        },
        "expected": {
            "routing": {
                "requiredTools": ["updateDiagram"],
                "forbiddenTools": [
                    "createDiagram",
                    "deleteDiagram",
                    "clearCanvas",
                    "getCanvasState"
                ]
            },
            "editing": {
                "changedNodes": [{ "id": "worker", "label": "Queue Consumer" }],
                "nodesAbsent": ["Worker"],
                "preservedIds": ["api", "job-queue"],
                "connectionsPresent": [
                    { "from": "API", "to": "Job Queue" },
                    { "from": "Job Queue", "to": "Queue Consumer" }
                ]
            }
        }
    },
