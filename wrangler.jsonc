{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "technical-drawing-agent",
    // Set this to today's date
    "compatibility_date": "2026-08-03",
    "compatibility_flags": ["nodejs_compat"],
    "main": "./src/server/index.ts",
    // register the AI runtime
    // "ai": {
    //     "binding": "AI",
    // },

    "durable_objects": {
        "bindings": [
            {
                "name": "ExcaliAgent",
                "class_name": "ExcaliAgent",
            },
        ],
    },

    "exports": {
        "ExcaliAgent": {
            "type": "durable-object",
            "storage": "sqlite",
        },
    },
}
